@top Program { declaration* }

@precedence {
  application @left,
  arrow @right,
  operator @right
}

declaration[@isGroup=Declaration] {
  AssignmentDec |
  AnnotationDec
}

AnnotationDec { Name @specialize<ConSym, ":"> type }

AssignmentDec { Name @specialize<VarSym, "="> expression }

expression { Name | Number | BinaryExpression }

FunctionApp { expression !application expression }

BinaryExpression { expression !operator VarSym expression }

// Types

type[@isGroup=Type] {
  ArrowType |
  TypeVar |
  TypeApp
}

TypeVar { Name }

TypeApp { type !application type }

ArrowType { type !arrow @specialize<VarSym, "->"> type }

@external tokens tokenizeSymbol from "./tokens.js" { Comment, VarSym, ConSym }

@skip { whitespace | Comment }

@tokens {
  whitespace { " " | "\t" }
  Name { @asciiLetter+ }
  Number { @digit+ }
}